# TrustBooker environment template
# Copy to .env.local for local development. NEVER commit real secrets.

# --- Runtime ---
NODE_ENV=development

# --- Public / client-safe (Vite) ---
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:3000
VITE_DEFAULT_LOCALE=en-GB

# --- Server-only (NEVER prefix with VITE_) ---
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
INTERNAL_ADMIN_BOOTSTRAP_SECRET=

# --- Identity verification ---
IDENTITY_VERIFICATION_ENABLED=false

# --- Marketplace payments (keep disabled until approved and tested) ---
PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=none
PAYMENTS_LIVE_MODE=false
PAYMENT_CHECKOUT_ENABLED=false
PAYMENT_PROVIDER_ONBOARDING_ENABLED=false
MOLLIE_CONNECT_ENABLED=false
MOLLIE_TEST_MODE_REQUIRED=true
MOLLIE_DELAYED_ROUTING_ENABLED=false
MOLLIE_NEXTGEN_WEBHOOKS_ENABLED=false
MOLLIE_SANDBOX_EVIDENCE_ENABLED=false
PAYOUT_RELEASE_ENABLED=false
REFUNDS_ENABLED=false
CHARGEBACK_AUTOMATION_ENABLED=false
FUNDS_FLOW_APPROVED=false
PAYMENT_PRODUCTION_ACTIVATED=false
MOLLIE_TEST_API_KEY=
MOLLIE_CLIENT_ID=
MOLLIE_CLIENT_SECRET=
MOLLIE_REDIRECT_URI=
MOLLIE_PLATFORM_ACCESS_TOKEN=
MOLLIE_PLATFORM_ORGANIZATION_ID=
MOLLIE_PLATFORM_PROFILE_ID=
MOLLIE_WEBHOOK_URL=
MOLLIE_NEXTGEN_WEBHOOK_URL=
MOLLIE_ALLOWED_SELLER_ORGANIZATION_IDS=
PAYMENT_TOKEN_ENCRYPTION_KEY=

# --- Email / Maps ---
# RESEND_API_KEY=
# GOOGLE_MAPS_API_KEY=
